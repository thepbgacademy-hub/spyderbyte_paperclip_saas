NODE_ENV=development
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
REDIS_URL=redis://localhost:6379
PAPERCLIP_BASE_URL=https://paperclip.internal.local
PAPERCLIP_SERVICE_TOKEN=replace-with-paperclip-service-token
SUPABASE_DB_URL=postgresql://postgres.tenant:replace-with-password@127.0.0.1:5432/postgres
SUPABASE_DB_SSL=false
WF_ALLOWED_ORIGINS=https://www.spyderbyte.cloud
WF_API_PORT=8080
WF_API_SESSION_SIGNING_KEY=replace-with-at-least-24-characters
WF_API_SESSION_ISSUER=wealth-factory-runtime
WF_API_SESSION_AUDIENCE=wealth-factory-portal
WF_VAULT_MASTER_KEY=replace-with-at-least-24-characters
WF_WEB_APP_ENTRY_URL=https://api.spyderbyte.cloud/app-assets/index-REPLACE_WITH_BUILD_HASH.js
WF_WEB_APP_STYLESHEET_URL=https://api.spyderbyte.cloud/app-assets/index-REPLACE_WITH_BUILD_HASH.css
WF_PORTAL_SESSION_COOKIE_NAME=wf_portal_session
WF_PAPERCLIP_LAUNCH_MODE=runs
WF_PAPERCLIP_BOARD_SESSION_TOKEN=
# Use this only for trusted board-session request headers. Keep PAPERCLIP_BASE_URL on the private runtime address.
WF_PAPERCLIP_BOARD_ORIGIN=https://paperclip.internal.local
# Deprecated for the issue-launch secret-projection path. Do not rely on it as a bearer-token fallback.
WF_PAPERCLIP_ADMIN_TOKEN=
WF_PAPERCLIP_ISSUE_AGENT_ID=
WF_PAPERCLIP_ISSUE_POLL_INTERVAL_MS=1000
WF_PAPERCLIP_ISSUE_MAX_POLL_ATTEMPTS=10
WF_PAPERCLIP_AUTH_PROBE_COMPANY_ID=
